{
  "name": "Inspiration Storefront – Promo Banners + Bestsellers Carousel",
  "viewport": { "width": 834, "height": 880 },
  "tokens": {
    "colors": {
      "primary": "#1C2E3D",
      "background": "#FFFFFF",
      "surfaceMuted": "#E8E8E8",
      "cardBackground": "#EEEEEE",
      "text": "#1C2E3D",
      "textMuted": "#555B61",
      "border": "#D9D9D9",
      "onImage": "#FFFFFF",
      "heroHeading": "#F2EBCB"
    },
    "typography": {
      "heading": { "family": "Serif Display (e.g. 'Canela', 'Playfair Display')", "weight": 400 },
      "body": { "family": "Inter, sans-serif", "weights": [400, 500] },
      "scale": { "bannerTitleLg": 44, "bannerTitleMd": 38, "eyebrow": 11, "bannerBody": 11, "sectionTitle": 17, "vendor": 11, "title": 11, "price": 11, "link": 11 }
    },
    "radius": { "md": 6 },
    "spacing": { "xs": 4, "sm": 8, "md": 14, "lg": 24, "xl": 40 }
  },
  "layout": {
    "type": "page",
    "children": [
      {
        "id": "header",
        "type": "navbar",
        "height": 42,
        "background": "background",
        "borderBottom": "1px solid border",
        "padding": "0 14px",
        "layout": "row, space-between, align-center",
        "left": [
          { "type": "icon", "name": "menu" },
          { "type": "logo", "text": "INSPIRATION", "weight": 600, "letterSpacing": "0.12em", "size": 14 },
          { "type": "navLinks", "items": ["Shop All", "Collections", "Journal", "Features"], "size": 12, "gap": 11 }
        ],
        "right": [
          { "type": "regionSelector", "flag": "CA", "label": "Change the Region", "size": 10, "color": "textMuted" },
          { "type": "icon", "name": "search" },
          { "type": "icon", "name": "moon" },
          { "type": "icon", "name": "user" },
          { "type": "icon", "name": "bag" }
        ],
        "behavior": "sticky, announcement bar scrolled away"
      },
      {
        "id": "promoBanners",
        "type": "grid",
        "columns": 2,
        "gap": 17,
        "padding": "25px 14px 0",
        "banners": [
          {
            "size": { "width": 396, "height": 264 },
            "radius": "md",
            "background": { "type": "image", "src": "banner-black-friday.jpg", "fit": "cover", "overlay": "rgba(0,0,0,0.15)" },
            "content": {
              "layout": "column, center",
              "eyebrow": { "text": "Black Friday", "size": 11, "color": "onImage", "position": "top, offset 28" },
              "title": { "text": "Sale Up to 50%", "font": "heading", "size": 38, "color": "heroHeading", "align": "center", "lineHeight": 1.0 },
              "body": {
                "text": "High-quality wall art, prints, and illustrations at half the price for a limited time.",
                "size": 11,
                "color": "onImage",
                "align": "center",
                "maxWidth": 320,
                "position": "bottom, offset 36"
              }
            }
          },
          {
            "size": { "width": 396, "height": 264 },
            "radius": "md",
            "background": { "type": "image", "src": "banner-new-collection.jpg", "fit": "cover", "overlay": "rgba(0,0,0,0.25)" },
            "content": {
              "layout": "column, center",
              "eyebrow": { "text": "New Collection", "size": 11, "color": "onImage", "position": "top, offset 28" },
              "title": { "text": "Decorate Your Home & Office With Stunning Wall Art", "font": "heading", "size": 44, "color": "heroHeading", "align": "center", "lineHeight": 1.0, "maxWidth": 280 },
              "body": {
                "text": "Modern, classic, and abstract designs to transform your walls.",
                "size": 11,
                "color": "onImage",
                "align": "center",
                "position": "bottom, offset 36"
              }
            }
          }
        ]
      },
      {
        "id": "bestsellers",
        "type": "section",
        "padding": "56px 0 0",
        "header": {
          "padding": "0 14px",
          "title": "Bestsellers",
          "font": "heading",
          "size": 17,
          "actions": [
            { "type": "iconButton", "name": "arrow-left", "state": "disabled", "color": "textMuted" },
            { "type": "iconButton", "name": "arrow-right", "state": "enabled", "color": "text" },
            { "type": "button", "variant": "secondary", "label": "View All", "size": { "width": 69, "height": 31 }, "background": "surfaceMuted", "radius": "md" }
          ]
        },
        "carousel": {
          "marginTop": 16,
          "gap": 6,
          "cardWidth": 266,
          "peek": { "left": 6, "note": "previous card slightly visible on the left edge" },
          "scrollSnap": true,
          "card": {
            "media": {
              "height": 355,
              "background": "cardBackground",
              "radius": "md",
              "image": { "width": 161, "height": 226, "fit": "contain", "layout": "center" },
              "hoverImage": { "fit": "cover", "note": "lifestyle photo replaces packshot on hover" }
            },
            "info": {
              "marginTop": 8,
              "gap": 4,
              "rows": [
                { "field": "collection", "size": 11, "weight": 500, "color": "text" },
                { "field": "title", "size": 11, "color": "textMuted" },
                { "field": "price", "size": 11, "weight": 500, "color": "text" }
              ],
              "hoverActions": {
                "replaces": "price",
                "layout": "row, divider 1px border",
                "items": [
                  { "label": "Shop Now", "weight": 500, "color": "text" },
                  { "label": "Quick View", "color": "textMuted" }
                ]
              }
            }
          },
          "items": [
            {
              "image": "the-man-i-met-at-a-bar.jpg",
              "alt": "Painting of a man in white shirt against blue sky",
              "collection": "Swipe Pastel",
              "title": "The Man I Met at a Bar By Lolita Pelegrime",
              "price": "$210.00"
            },
            {
              "image": "different-ways-blue-lifestyle.jpg",
              "alt": "Two framed prints on concrete wall (hover state)",
              "state": "hover",
              "collection": "Swipe Pastel",
              "title": "Different Ways - Blue By Robin Ahlgren",
              "actions": ["Shop Now", "Quick View"]
            },
            {
              "image": "her-by-kit-agar.jpg",
              "alt": "Abstract face in pastel and navy brush strokes",
              "collection": "Swipe Pastel",
              "title": "Her By Kit Agar",
              "price": "$175.00"
            }
          ]
        }
      }
    ]
  }
}