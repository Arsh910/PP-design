{
  "name": "Inspiration Storefront – Paintings Collection (Banner + Product Grid)",
  "viewport": { "width": 834, "height": 880 },
  "tokens": {
    "colors": {
      "primary": "#1C2E3D",
      "background": "#FFFFFF",
      "surfaceMuted": "#E8E8E8",
      "cardBackground": "#EEEEEE",
      "text": "#1C2E3D",
      "textMuted": "#555B61",
      "border": "#D9D9D9",
      "onImage": "#FFFFFF"
    },
    "typography": {
      "heading": { "family": "Serif Display (e.g. 'Canela', 'Playfair Display')", "weight": 400 },
      "body": { "family": "Inter, sans-serif", "weights": [400, 500] },
      "scale": { "bannerTitle": 20, "bannerBody": 11, "vendor": 10, "title": 10, "price": 10, "link": 10 }
    },
    "radius": { "md": 6 },
    "spacing": { "xs": 4, "sm": 8, "md": 14, "lg": 24, "xl": 40 }
  },
  "layout": {
    "type": "page",
    "children": [
      {
        "id": "header",
        "type": "navbar",
        "sticky": true,
        "height": 42,
        "background": "background",
        "borderBottom": "1px solid border",
        "padding": "0 14px",
        "layout": "row, space-between, align-center",
        "left": [
          { "type": "icon", "name": "menu" },
          { "type": "logo", "text": "INSPIRATION", "weight": 600, "letterSpacing": "0.12em", "size": 14 },
          { "type": "navLinks", "items": ["Shop All", "Collections", "Journal", "Features"], "size": 12, "gap": 11 }
        ],
        "right": [
          { "type": "regionSelector", "flag": "CA", "label": "Change the Region", "size": 10, "color": "textMuted" },
          { "type": "icon", "name": "search" },
          { "type": "icon", "name": "moon" },
          { "type": "icon", "name": "user" },
          { "type": "icon", "name": "bag" }
        ]
      },
      {
        "id": "collectionBanner",
        "type": "banner",
        "padding": "0 14px",
        "size": { "width": 810, "height": 103 },
        "radius": "md",
        "overflow": "hidden",
        "background": { "type": "image", "src": "paintings-banner-plant-and-motion-blur.jpg", "fit": "cover", "overlay": "linear-gradient(to bottom, rgba(0,0,0,0.05), rgba(0,0,0,0.35))" },
        "content": {
          "position": { "bottom": 20, "left": 22 },
          "title": { "text": "Paintings", "font": "heading", "size": 20, "color": "onImage" },
          "body": {
            "text": "Breathtaking landscapes, vivid portraits, and abstract emotions come alive in this diverse collection of paintings.",
            "size": 11,
            "lineHeight": 1.3,
            "color": "onImage",
            "maxWidth": 285,
            "marginTop": 2
          }
        }
      },
      {
        "id": "productGrid",
        "type": "grid",
        "padding": "17px 14px 0",
        "columns": 3,
        "columnGap": 16,
        "rowGap": 24,
        "card": {
          "type": "productCard",
          "width": 259,
          "media": {
            "height": 344,
            "background": "cardBackground",
            "radius": "md",
            "overflow": "hidden",
            "image": { "width": 157, "height": 218, "fit": "contain", "layout": "center", "note": "packshot with white border" },
            "hoverImage": { "fit": "cover", "note": "lifestyle photo replaces packshot on hover" }
          },
          "info": {
            "marginTop": 8,
            "gap": 3,
            "rows": [
              { "field": "collection", "size": 10, "weight": 500, "color": "text" },
              { "field": "title", "size": 10, "color": "textMuted" },
              { "field": "price", "size": 10, "weight": 500, "color": "text" }
            ],
            "hoverActions": {
              "replaces": "price",
              "layout": "row",
              "divider": "1px solid border",
              "items": [
                { "label": "Shop Now", "weight": 500, "color": "text" },
                { "label": "Quick View", "color": "textMuted" }
              ]
            }
          }
        },
        "items": [
          {
            "image": "comfort-yellow.jpg",
            "alt": "Yellow brush strokes on white",
            "collection": "Swipe Pastel",
            "title": "Comfort - Yellow By Ronelle Pienaar Jenkin x Lemon",
            "price": "$180.00"
          },
          {
            "image": "linocut-ii-lifestyle.jpg",
            "alt": "Navy figure print framed by window beside armchair (hover state)",
            "state": "hover",
            "collection": "Swipe Pastel",
            "title": "Linocut II By Jazmine Joye",
            "actions": ["Shop Now", "Quick View"]
          },
          {
            "image": "painted-shapes-02.jpg",
            "alt": "Rust, plum and cream organic shapes with blue sky",
            "collection": "Swipe Pastel",
            "title": "Painted Shapes 02 By Berit Mogensen Lopez",
            "price": "$200.00"
          },
          {
            "image": "her-by-kit-agar.jpg",
            "alt": "Abstract face in pastel and navy brush strokes",
            "collection": null,
            "title": null,
            "price": null,
            "note": "Row cut off at viewport bottom; text not visible"
          },
          {
            "image": "the-man-i-met-at-a-bar.jpg",
            "alt": "Painting of a man in white shirt against blue sky",
            "collection": null,
            "title": null,
            "price": null
          },
          {
            "image": "palm-print-blue-orange.jpg",
            "alt": "Orange palm illustration on blue watercolor wash",
            "collection": null,
            "title": null,
            "price": null
          }
        ]
      }
    ]
  }
}