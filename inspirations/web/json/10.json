{
  "name": "Inspiration Storefront – Stories (text), Popular Brands, Footer",
  "viewport": { "width": 834, "height": 880 },
  "tokens": {
    "colors": {
      "primary": "#1C2E3D",
      "onPrimary": "#F2EBCB",
      "background": "#FFFFFF",
      "footerBackground": "#E8E8E8",
      "inputBackground": "#FFFFFF",
      "text": "#1C2E3D",
      "textMuted": "#555B61",
      "border": "#D9D9D9",
      "required": "#D32F2F"
    },
    "typography": {
      "heading": { "family": "Serif Display (e.g. 'Canela', 'Playfair Display')", "weight": 400 },
      "body": { "family": "Inter, sans-serif", "weights": [400, 500] },
      "scale": { "eyebrow": 10, "storyTitle": 14, "brandsLabel": 10, "footerHeading": 15, "footerLink": 9, "select": 9, "button": 10, "body": 12, "copyright": 9 }
    },
    "radius": { "md": 6, "sm": 2 },
    "spacing": { "xs": 4, "sm": 8, "md": 14, "lg": 24, "xl": 40 }
  },
  "layout": {
    "type": "page",
    "children": [
      {
        "id": "popularStories",
        "type": "section",
        "padding": "0 14px",
        "note": "Continuation of the Popular Stories carousel (image bottoms visible)",
        "carousel": {
          "columns": 3,
          "gap": 16,
          "card": {
            "type": "storyCard",
            "width": 259,
            "image": { "radius": "md", "fit": "cover" },
            "eyebrow": { "field": "category", "size": 10, "color": "text", "marginTop": 14 },
            "title": { "field": "title", "font": "heading", "size": 14, "lineHeight": 1.0, "color": "text", "marginTop": 8, "maxLines": 3 }
          },
          "items": [
            { "image": "story-framed-blue-prints-on-paper.jpg", "category": "Style", "title": "Grants and Opportunities for Artists Worldwide Seeking Inspiration and Funding" },
            { "image": "story-black-abstract-print-pink-chair.jpg", "category": "Style", "title": "Learning the Constructive Process of Art Critique to Develop a Keen Eye" },
            { "image": "story-woman-with-scarf-in-doorway.jpg", "category": "Style", "title": "Iconic Artworks from Da Vinci to Warhol: Recognizing Timeless Masterpieces" }
          ]
        },
        "marginBottom": 54,
        "borderBottom": "1px solid border"
      },
      {
        "id": "popularBrands",
        "type": "section",
        "padding": "56px 0 0",
        "label": { "text": "Popular Brands", "size": 10, "color": "textMuted", "padding": "0 14px" },
        "marquee": {
          "marginTop": 24,
          "height": 40,
          "gap": 44,
          "overflow": "hidden",
          "animation": { "direction": "left", "loop": true, "pauseOnHover": true },
          "logoStyle": { "color": "primary", "height": 24, "fit": "contain" },
          "items": [
            { "name": "lumina", "style": "bold geometric sans, lowercase" },
            { "name": "URBAN EDGE", "style": "heavy condensed sans, uppercase" },
            { "name": "Serene", "style": "light serif" },
            { "name": "Nexus", "style": "medium sans" },
            { "name": "PRISM", "style": "bold wide sans, uppercase" },
            { "name": "12|22", "style": "bold sans with vertical bar" },
            { "name": "KINETIC", "style": "bold condensed sans, uppercase" }
          ]
        },
        "marginBottom": 76
      },
      {
        "id": "footer",
        "type": "footer",
        "background": "footerBackground",
        "padding": "24px 14px 0",
        "columns": {
          "layout": "row",
          "gap": 27,
          "items": [
            {
              "id": "company",
              "heading": { "text": "Company", "font": "heading", "size": 15 },
              "links": ["Shop All", "Collections", "About"],
              "linkStyle": { "size": 9, "color": "text", "gap": 17 }
            },
            {
              "id": "collections",
              "heading": { "text": "Collections", "font": "heading", "size": 15 },
              "links": ["Graphic", "Illustrations", "Line", "Paintings"],
              "linkStyle": { "size": 9, "color": "text", "gap": 17 }
            },
            {
              "id": "customerSupport",
              "heading": { "text": "Customer Support", "font": "heading", "size": 15 },
              "links": ["Contact", "Privacy Policy", "Refund Policy", "Terms of Service", "Shipping Policy"],
              "linkStyle": { "size": 9, "color": "text", "gap": 17 }
            },
            {
              "id": "paymentDetails",
              "width": 168,
              "heading": { "text": "Payment Details", "font": "heading", "size": 15 },
              "controls": [
                {
                  "type": "dropdown",
                  "label": "Canada (CAD $)",
                  "leading": { "type": "flag", "country": "CA" },
                  "trailingIcon": "arrow-down",
                  "height": 31,
                  "background": "inputBackground",
                  "radius": "md",
                  "size": 9,
                  "marginTop": 10
                },
                {
                  "type": "dropdown",
                  "label": "English",
                  "trailingIcon": "arrow-down",
                  "height": 31,
                  "background": "inputBackground",
                  "radius": "md",
                  "size": 9,
                  "marginTop": 6
                }
              ],
              "paymentIcons": {
                "marginTop": 16,
                "gap": 4,
                "icons": ["visa", "mastercard", "amex", "paypal", "diners", "discover"],
                "iconSize": { "width": 22, "height": 14 }
              }
            },
            {
              "id": "newsletter",
              "width": 246,
              "heading": { "text": "Subscribe to Our Newsletter", "font": "heading", "size": 15 },
              "form": {
                "layout": "row",
                "gap": 6,
                "marginTop": 10,
                "input": {
                  "type": "email",
                  "placeholder": "E-mail",
                  "required": true,
                  "requiredMarker": { "text": "*", "color": "required" },
                  "height": 31,
                  "background": "inputBackground",
                  "radius": "md",
                  "size": 10
                },
                "button": {
                  "variant": "primary",
                  "label": "Subscribe",
                  "height": 31,
                  "padding": "0 10px",
                  "background": "primary",
                  "color": "onPrimary",
                  "radius": "md",
                  "size": 10
                }
              },
              "credit": {
                "marginTop": 24,
                "size": 12,
                "lineHeight": 1.4,
                "color": "textMuted",
                "text": "Special thanks to {partner} for generously providing us with their stunning product imagery. Kindly visit their website to make real purchases of their products.",
                "links": { "partner": "Paper Collective" },
                "linkStyle": { "color": "text", "weight": 500 }
              }
            }
          ]
        },
        "divider": { "marginTop": 24, "height": 1, "color": "border" },
        "bottomBar": {
          "layout": "row, space-between, align-center",
          "height": 80,
          "left": {
            "logo": { "text": "INSPIRATION", "weight": 600, "letterSpacing": "0.12em", "size": 14 },
            "copyright": { "text": "© 2026 Inspiration. Powered by Shopify", "size": 9, "color": "textMuted", "marginLeft": 12 }
          },
          "right": {
            "social": {
              "gap": 22,
              "iconSize": 16,
              "color": "primary",
              "items": ["x", "facebook", "instagram", "youtube"]
            }
          }
        }
      }
    ]
  }
}