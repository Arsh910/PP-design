{
  "name": "Inspiration Storefront – Item of the Day + Popular Stories",
  "viewport": { "width": 834, "height": 880 },
  "tokens": {
    "colors": {
      "primary": "#1C2E3D",
      "onPrimary": "#F2EBCB",
      "background": "#FFFFFF",
      "surfaceMuted": "#E8E8E8",
      "cardBackground": "#EEEEEE",
      "text": "#1C2E3D",
      "textMuted": "#555B61",
      "border": "#D9D9D9"
    },
    "typography": {
      "heading": { "family": "Serif Display (e.g. 'Canela', 'Playfair Display')", "weight": 400 },
      "body": { "family": "Inter, sans-serif", "weights": [400, 500] },
      "scale": { "sectionTitle": 19, "sectionSub": 12, "vendor": 11, "productTitle": 24, "price": 12, "tax": 10, "label": 10, "select": 11, "button": 11, "link": 10 }
    },
    "radius": { "md": 6 },
    "spacing": { "xs": 4, "sm": 8, "md": 14, "lg": 24, "xl": 40 }
  },
  "layout": {
    "type": "page",
    "children": [
      {
        "id": "header",
        "type": "navbar",
        "sticky": true,
        "height": 42,
        "background": "background",
        "borderBottom": "1px solid border",
        "padding": "0 14px",
        "layout": "row, space-between, align-center",
        "left": [
          { "type": "icon", "name": "menu" },
          { "type": "logo", "text": "INSPIRATION", "weight": 600, "letterSpacing": "0.12em", "size": 14 },
          { "type": "navLinks", "items": ["Shop All", "Collections", "Journal", "Features"], "size": 12, "gap": 11 }
        ],
        "right": [
          { "type": "regionSelector", "flag": "CA", "label": "Change the Region", "size": 10, "color": "textMuted" },
          { "type": "icon", "name": "search" },
          { "type": "icon", "name": "moon" },
          { "type": "icon", "name": "user" },
          { "type": "icon", "name": "bag" }
        ]
      },
      {
        "id": "itemOfTheDay",
        "type": "section",
        "padding": "24px 14px 0",
        "header": {
          "title": { "text": "Item of the Day", "font": "heading", "size": 19, "color": "text" },
          "subtitle": { "text": "A standout art item, perfect for any collection.", "size": 12, "color": "textMuted", "marginTop": 4 }
        },
        "content": {
          "marginTop": 14,
          "layout": "row",
          "gap": 17,
          "gallery": {
            "width": 506,
            "height": 335,
            "layout": "row",
            "gap": 3,
            "radius": "md",
            "overflow": "hidden",
            "images": [
              {
                "width": 251,
                "background": "cardBackground",
                "image": { "src": "orange-brush-packshot.jpg", "width": 153, "height": 212, "fit": "contain", "layout": "center", "note": "white-bordered print" }
              },
              {
                "width": 252,
                "image": { "src": "orange-brush-lifestyle-arched-niche.jpg", "fit": "cover" }
              }
            ],
            "note": "Two-image gallery, likely scrollable/swipeable with more images"
          },
          "details": {
            "width": 275,
            "layout": "column",
            "align": "center",
            "vendor": { "text": "Swipe Pastel", "size": 11, "color": "text" },
            "title": { "text": "Orange Brush by Berit Mogensen Lopez", "font": "heading", "size": 24, "lineHeight": 1.0, "align": "center", "marginTop": 6 },
            "price": { "text": "$150.00", "size": 12, "weight": 500, "marginTop": 12 },
            "taxNote": {
              "text": "Tax included. {shipping} calculated at checkout.",
              "links": { "shipping": "Shipping" },
              "linkStyle": "underline",
              "size": 10,
              "color": "textMuted",
              "marginTop": 8
            },
            "variantPicker": {
              "width": "100%",
              "marginTop": 14,
              "label": { "text": "Choose a Size", "size": 10, "weight": 500, "align": "left" },
              "select": {
                "type": "dropdown",
                "value": "30×40 cm",
                "height": 31,
                "background": "surfaceMuted",
                "radius": "md",
                "padding": "0 12px",
                "size": 11,
                "trailingIcon": "arrow-down",
                "marginTop": 4
              }
            },
            "addToCart": {
              "type": "button",
              "variant": "primary",
              "label": "Add to Cart",
              "width": "100%",
              "height": 31,
              "background": "primary",
              "color": "onPrimary",
              "radius": "md",
              "marginTop": 12
            },
            "link": { "text": "View Full Details", "size": 10, "underline": true, "color": "text", "marginTop": 26 }
          }
        }
      },
      {
        "id": "popularStories",
        "type": "section",
        "padding": "56px 14px 0",
        "header": {
          "title": { "text": "Popular Stories", "font": "heading", "size": 17 },
          "actions": [
            { "type": "iconButton", "name": "arrow-left", "state": "disabled", "color": "textMuted" },
            { "type": "iconButton", "name": "arrow-right", "state": "enabled", "color": "text" },
            { "type": "button", "variant": "secondary", "label": "View All", "size": { "width": 69, "height": 31 }, "background": "surfaceMuted", "color": "text", "radius": "md" }
          ]
        },
        "carousel": {
          "marginTop": 16,
          "columns": 3,
          "gap": 16,
          "card": {
            "type": "storyCard",
            "width": 259,
            "image": { "ratio": "3/4", "fit": "cover", "radius": "md" },
            "note": "Text content below images not visible (cut off at viewport bottom)"
          },
          "items": [
            { "image": "story-framed-blue-prints-on-paper.jpg" },
            { "image": "story-black-abstract-print-pink-chair.jpg" },
            { "image": "story-woman-with-scarf-in-doorway.jpg" }
          ]
        }
      }
    ]
  }
}