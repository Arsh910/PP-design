{
  "name": "Inspiration Storefront – Before/After, Item of the Week, New Collection",
  "viewport": { "width": 834, "height": 880 },
  "tokens": {
    "colors": {
      "primary": "#1C2E3D",
      "onPrimary": "#FFFFFF",
      "background": "#FFFFFF",
      "surfaceMuted": "#E8E8E8",
      "text": "#1C2E3D",
      "textMuted": "#555B61",
      "border": "#D9D9D9",
      "labelBg": "#FFFFFF"
    },
    "typography": {
      "heading": { "family": "Serif Display (e.g. 'Canela', 'Playfair Display')", "weight": 400 },
      "body": { "family": "Inter, sans-serif", "weights": [400, 500] },
      "scale": { "eyebrow": 10, "sectionTitle": 19, "subTitle": 17, "vendor": 10, "productTitle": 10, "price": 10, "label": 10, "button": 10 }
    },
    "radius": { "sm": 2, "md": 6 },
    "spacing": { "xs": 4, "sm": 8, "md": 14, "lg": 24, "xl": 40 }
  },
  "layout": {
    "type": "page",
    "children": [
      {
        "id": "beforeAfter",
        "type": "section",
        "padding": "42px 14px 0",
        "layout": "row",
        "gap": 17,
        "left": {
          "width": 308,
          "layout": "column",
          "justify": "space-between",
          "intro": {
            "eyebrow": { "text": "Before/After", "size": 10, "color": "textMuted" },
            "title": { "text": "See the Real-Time Art Transformation of Your Space", "font": "heading", "size": 19, "lineHeight": 1.0, "marginTop": 8 }
          },
          "selectedItem": {
            "title": { "text": "Shop Selected Item", "font": "heading", "size": 17 },
            "card": {
              "type": "productRow",
              "marginTop": 8,
              "height": 70,
              "background": "surfaceMuted",
              "radius": "md",
              "overflow": "hidden",
              "thumbnail": { "width": 50, "fit": "cover", "image": "painted-shapes-02.jpg" },
              "info": {
                "padding": "0 14px",
                "rows": [
                  { "field": "collection", "value": "Swipe Pastel", "size": 10, "weight": 500 },
                  { "field": "title", "value": "Painted Shapes 02 By Berit Mogensen Lopez", "size": 10, "color": "textMuted", "maxLines": 2 },
                  { "field": "price", "value": "$200.00", "size": 10, "weight": 500 }
                ]
              },
              "trailing": { "type": "icon", "name": "arrow-right", "size": 16, "marginRight": 14 }
            }
          }
        },
        "right": {
          "type": "beforeAfterSlider",
          "size": { "width": 484, "height": 213 },
          "radius": "md",
          "overflow": "hidden",
          "initialPosition": 0.42,
          "before": { "image": "room-before.jpg", "label": "Before", "labelPosition": "bottom-left" },
          "after": { "image": "room-after.jpg", "label": "After", "labelPosition": "top-right" },
          "label": { "background": "labelBg", "color": "text", "size": 10, "padding": "4px 8px", "radius": "sm", "inset": 8 },
          "divider": { "width": 1, "color": "#FFFFFF" },
          "handle": { "size": { "width": 31, "height": 31 }, "background": "#FFFFFF", "radius": "md", "icon": "grip-vertical", "shadow": "0 1px 4px rgba(0,0,0,0.15)" }
        }
      },
      {
        "id": "itemOfTheWeek",
        "type": "section",
        "padding": "52px 14px 0",
        "header": {
          "eyebrow": { "text": "Item of the Week", "size": 10, "color": "textMuted" },
          "title": { "text": "Spotlight this Week's Essential Art Selection", "font": "heading", "size": 19, "lineHeight": 1.0, "maxWidth": 320, "marginTop": 8 }
        },
        "media": {
          "marginTop": 16,
          "size": { "width": 806, "height": 352 },
          "radius": "md",
          "background": { "type": "image", "src": "spotlight-room-two-frames-lamp.jpg", "fit": "cover" },
          "cta": {
            "type": "shopTheLook",
            "position": { "bottom": 14, "left": 14 },
            "size": { "width": 262, "height": 40 },
            "background": "primary",
            "color": "onPrimary",
            "radius": "md",
            "padding": "0 16px",
            "layout": "row, space-between, align-center",
            "left": { "text": "Shop the Look", "size": 10, "weight": 500 },
            "right": { "text": "2 Products", "size": 10, "color": "rgba(255,255,255,0.7)" }
          }
        }
      },
      {
        "id": "newCollection",
        "type": "section",
        "padding": "56px 14px 0",
        "card": {
          "layout": "row",
          "height": 300,
          "radius": "md",
          "overflow": "hidden",
          "left": { "width": "50%", "background": { "type": "image", "src": "new-collection-room.jpg", "fit": "cover" } },
          "right": {
            "width": "50%",
            "background": "surfaceMuted",
            "padding": "0 45px",
            "layout": "column, center",
            "eyebrow": { "text": "New Collection", "size": 10 },
            "title": { "text": "Discover the Newest Additions to Our Art Collection", "font": "heading", "size": 19, "lineHeight": 1.0, "maxWidth": 250, "marginTop": 6 },
            "nav": {
              "position": { "right": 40 },
              "items": [
                { "type": "iconButton", "name": "arrow-left", "state": "disabled" },
                { "type": "iconButton", "name": "arrow-right", "state": "enabled" }
              ]
            },
            "note": "Cut off at viewport bottom; remaining content (product carousel) not visible"
          }
        }
      }
    ]
  }
}