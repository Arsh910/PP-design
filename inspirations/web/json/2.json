{
  "name": "Inspiration Storefront – Home",
  "viewport": { "width": 834, "height": 880 },
  "tokens": {
    "colors": {
      "primary": "#1C2E3D",
      "onPrimary": "#FFFFFF",
      "background": "#FFFFFF",
      "surfaceMuted": "#E8E8E8",
      "text": "#1C2E3D",
      "textMuted": "#6B7280",
      "border": "#D9D9D9",
      "heroHeading": "#F2EBCB"
    },
    "typography": {
      "heading": { "family": "Serif Display (e.g. 'Canela', 'Playfair Display')", "weight": 400 },
      "body": { "family": "Inter, sans-serif", "weights": [400, 500] },
      "scale": {
        "announcement": 10,
        "nav": 12,
        "hero": 32,
        "badge": 24,
        "marquee": 16,
        "sectionTitle": 17,
        "cardTitle": 14,
        "caption": 10,
        "button": 11
      }
    },
    "radius": { "md": 6, "circle": "50%" },
    "spacing": { "xs": 4, "sm": 8, "md": 14, "lg": 24, "xl": 40 }
  },
  "layout": {
    "type": "page",
    "children": [
      {
        "id": "announcementBar",
        "type": "bar",
        "height": 28,
        "background": "primary",
        "content": {
          "align": "center",
          "color": "onPrimary",
          "size": 10,
          "text": "Back in Stock: Your Favorites are Here!",
          "link": { "text": "Shop Now", "underline": true }
        }
      },
      {
        "id": "header",
        "type": "navbar",
        "height": 42,
        "background": "background",
        "padding": "0 14px",
        "layout": "row, space-between, align-center",
        "left": [
          { "type": "icon", "name": "menu" },
          { "type": "logo", "text": "INSPIRATION", "weight": 600, "letterSpacing": "0.12em", "size": 14 },
          { "type": "navLinks", "items": ["Shop All", "Collections", "Journal", "Features"], "size": 12, "gap": 11 }
        ],
        "right": [
          { "type": "regionSelector", "flag": "CA", "label": "Change the Region", "size": 10, "color": "textMuted" },
          { "type": "icon", "name": "search" },
          { "type": "icon", "name": "moon" },
          { "type": "icon", "name": "user" },
          { "type": "icon", "name": "bag" }
        ]
      },
      {
        "id": "hero",
        "type": "section",
        "height": 320,
        "background": { "type": "image", "src": "hero-woman-hanging-framed-art.jpg", "fit": "cover", "position": "center" },
        "children": [
          {
            "type": "badge",
            "shape": "circle",
            "size": 112,
            "position": { "top": 14, "left": 14 },
            "background": "primary",
            "text": ["50%", "Off"],
            "color": "onPrimary",
            "font": "heading",
            "textSize": 24,
            "align": "center"
          },
          { "type": "eyebrow", "text": "Sale", "size": 10, "color": "#FFFFFF", "position": { "top": 150, "left": 14 } },
          {
            "type": "heading",
            "text": "Buy Art Online: Prints, Home & Office Decor",
            "font": "heading",
            "size": 32,
            "lineHeight": 1.0,
            "color": "heroHeading",
            "maxWidth": 320
          },
          {
            "type": "button",
            "variant": "primary",
            "label": "Shop Now",
            "size": { "width": 80, "height": 30 },
            "radius": "md",
            "position": { "left": 14, "top": 242 }
          },
          {
            "type": "marquee",
            "position": { "bottom": 10, "left": 0, "right": 0 },
            "item": "End of the Season. Sale Up to 50%",
            "separator": "✶",
            "color": "#FFFFFF",
            "size": 16,
            "weight": 500,
            "gap": 16,
            "animation": { "direction": "left", "loop": true }
          }
        ]
      },
      {
        "id": "discoverArtworks",
        "type": "section",
        "padding": "56px 14px 0",
        "header": {
          "title": "Discover Artworks",
          "font": "heading",
          "size": 17,
          "actions": [
            { "type": "iconButton", "name": "arrow-left", "state": "disabled", "color": "textMuted" },
            { "type": "iconButton", "name": "arrow-right", "state": "enabled", "color": "text" },
            { "type": "button", "variant": "secondary", "label": "View All", "size": { "width": 69, "height": 31 } }
          ]
        },
        "carousel": {
          "columns": 3,
          "gap": 16,
          "cardWidth": 259,
          "items": [
            {
              "image": "collection-graphic.jpg",
              "alt": "Blue vase print on wall beside red floor lamp",
              "eyebrow": "Collection",
              "title": "Graphic"
            },
            {
              "image": "collection-illustrations.jpg",
              "alt": "Framed figure illustration above espresso machine on sideboard",
              "eyebrow": "Collection",
              "title": "Illustrations"
            },
            {
              "image": "collection-line.jpg",
              "alt": "Black and beige line art print above sofa",
              "eyebrow": "Collection",
              "title": "Line"
            }
          ],
          "card": {
            "imageHeight": 145,
            "imageRadius": "md",
            "eyebrow": { "size": 10, "color": "textMuted" },
            "title": { "size": 14, "weight": 500, "color": "text" },
            "gapImageToText": 12
          }
        },
        "progressBar": {
          "height": 1,
          "track": "border",
          "fill": "primary",
          "progress": 0.5,
          "marginTop": 16
        }
      },
      {
        "id": "mostPopular",
        "type": "section",
        "padding": "56px 14px 0",
        "header": {
          "title": "Most Popular",
          "font": "heading",
          "size": 17,
          "actions": [
            { "type": "button", "variant": "secondary", "label": "View All", "size": { "width": 69, "height": 31 } }
          ]
        },
        "filterChips": {
          "items": ["Bestsellers", "Sale", "New Arrivals", "Graphic", "Illustrations", "Line"],
          "active": "Bestsellers",
          "gap": 6,
          "chip": { "height": 26, "radius": "md", "border": "1px solid border", "size": 10, "padding": "0 14px", "background": "background" },
          "activeChip": { "background": "surfaceMuted", "border": "none" }
        },
        "productGrid": {
          "columns": 3,
          "gap": 16,
          "marginTop": 20,
          "card": { "imageRatio": "4/5", "radius": "md", "badge": { "optional": true, "text": "Sale", "position": "top-left" } }
        }
      }
    ]
  },
  "components": {
    "button": {
      "primary": { "background": "primary", "color": "onPrimary", "radius": "md", "weight": 500, "size": 11 },
      "secondary": { "background": "surfaceMuted", "color": "text", "radius": "md", "weight": 500, "size": 11 }
    }
  }
}